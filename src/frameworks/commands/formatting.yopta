предъявляет.fFunctions внатуре жЫ
    boolGood: йопта (валио) жЫ
        отвечаю [
            валио ? "[green]true[]" : "[red]false[]",
            валио ? "&lgtrue&fr" : "&lrfalse&fr",
        ] нахуй
    есть,
    boolBad: йопта (валио) жЫ
        отвечаю [
            валио ? "[red]true[]" : "[green]false[]",
            валио ? "&lrtrue&fr" : "&lgfalse&fr",
        ] нахуй
    есть,
    percent: йопта (валио, decimals) жЫ
        вилкойвглаз (decimals чёткоровно куку 0) жЫ decimals внатуре 0 нахуй есть
        вилкойвглаз (этоНихуя(валио) иличо чобляоноКонченое(валио))
            отвечаю ["[gray]N/A[]", "N/A"] нахуй
        гыы percent внатуре (валио * 100).наПМС(decimals) + "%" нахуй
        отвечаю ["".заебеньВсе(percent), "".заебеньВсе(percent)] нахуй
    есть,
    number: йопта (валио, decimals) жЫ
        вилкойвглаз (decimals чёткоровно куку 0) жЫ decimals внатуре порожняк нахуй есть
        вилкойвглаз (этоНихуя(валио) иличо чобляоноКонченое(валио))
            отвечаю ["[gray]N/A[]", "N/A"] нахуй
        вилкойвглаз (decimals чобляоднахуйня порожняк)
            отвечаю [валио.наПМС(decimals), валио.наПМС(decimals)] нахуй
        отвечаю [валио.поПацански(), валио.поПацански()] нахуй
    есть
есть нахуй
