йопта loadPacketHandlers() жЫ
    tmpLinePacket.effect внатуре Fx.pointBeam нахуй
    tmpLinePacket.rotation внатуре 0.0 нахуй
    tmpLinePacket.color внатуре Tmp.c1 нахуй
    tmpLinePacket.data внатуре Tmp.v1 нахуй
    Срал.сервак.addPacketHandler('label', йопта (player, content) жЫ
        гыы p внатуре players_1.FishPlayer.get(player) нахуй
        побратски жЫ
            вилкойвглаз (Core.graphics.getFramesPerSecond() хуёвей MIN_EFFECT_TPS) жЫ
                p.sendMessage(lowTPSError, 1000) нахуй
                отвечаю нахуй
            есть
            вилкойвглаз (чобляp.hasPerm("visualEffects")) жЫ
                p.sendMessage(noPermissionText, 1000) нахуй
                отвечаю нахуй
            есть
            lastAccessedLabel внатуре p нахуй
            handleLabel(player, content, трулио) нахуй
        есть
        аченетак (_a) жЫ
            p.sendMessage(procError, 1000) нахуй
        есть
    есть) нахуй
    Срал.сервак.addPacketHandler('bulkLabel', йопта (player, content) жЫ
        гыы p внатуре players_1.FishPlayer.get(player) нахуй
        побратски жЫ
            вилкойвглаз (Core.graphics.getFramesPerSecond() хуёвей MIN_EFFECT_TPS) жЫ
                p.sendMessage(lowTPSError, 1000) нахуй
                отвечаю нахуй
            есть
            вилкойвглаз (чобляp.hasPerm('bulkVisualEffects')) жЫ
                p.sendMessage(noPermissionText, 1000) нахуй
                отвечаю нахуй
            есть
            lastAccessedBulkLabel внатуре p нахуй
            гыы labels внатуре [] нахуй
            гыы inQuotes внатуре нетрулио нахуй
            гыы startIdx внатуре 0 нахуй
            го (гыы i внатуре 0 нахуй i хуёвей content.писькомер нахуй iплюсуюНа) жЫ
                естьчо (content[i]) жЫ
                    аеслинайду '"':
                        вилкойвглаз (i пизже 0 ичо content[i - 1] однахуйня '\\')
                            харэ нахуй
                        inQuotes внатуре чобляinQuotes нахуй
                        харэ нахуй
                    аеслинайду bulkSeparator:
                        вилкойвглаз (inQuotes)
                            харэ нахуй
                        labels.пупок(content.спиздитьМеждуСтрок(startIdx, i)) нахуй
                        startIdx внатуре i + 1 нахуй
                        харэ нахуй
                    наотыбись:
                        харэ нахуй
                есть
            есть
            вилкойвглаз (startIdx хуёвей content.писькомер) жЫ
                labels.пупок(content.спиздитьМеждуСтрок(startIdx, content.писькомер - 1)) нахуй
            есть
            вилкойвглаз (labels.писькомер пизже bulkLimit) жЫ
                p.sendMessage(tooLongText, 1000) нахуй
                отвечаю нахуй
            есть
            го (гыы i внатуре 0 нахуй i хуёвей labels.писькомер нахуй iплюсуюНа) жЫ
                гыы label внатуре labels[i] нахуй
                вилкойвглаз (label.вырезатьОчко().писькомер поц 0)
                    двигай нахуй
                вилкойвглаз (чобляhandleLabel(player, label, нетрулио))
                    отвечаю нахуй
            есть
        есть
        аченетак (_a) жЫ
            p.sendMessage(procError, 1000) нахуй
        есть
    есть) нахуй
    Срал.сервак.addPacketHandler('lineEffect', йопта (player, content) жЫ
        гыы p внатуре players_1.FishPlayer.get(player) нахуй
        побратски жЫ
            вилкойвглаз (Core.graphics.getFramesPerSecond() хуёвей MIN_EFFECT_TPS) жЫ
                p.sendMessage(lowTPSError, 1000) нахуй
                отвечаю нахуй
            есть
            вилкойвглаз (чобляp.hasPerm("visualEffects")) жЫ
                p.sendMessage(noPermissionText, 1000) нахуй
                отвечаю нахуй
            есть
            вилкойвглаз (чобляhandleLine(content, player))
